{
  "name": "mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/http.ts",
    "start": "bun run src/http.ts",
    "start:stdio": "bun run src/stdio.ts",
    "build": "bun build src/http.ts --outdir dist --target bun",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "latest",
    "@repo/env": "*",
    "@t3-oss/env-core": "^0.13.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "latest",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
