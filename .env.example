# Copy to `.env` at the repo root (single file for the monorepo).
# Each app validates only the keys it needs via its own `src/env.ts` (createEnv).

# --- Local Degiroid API ---
DEGIROID_API_HOST=127.0.0.1
DEGIROID_API_PORT=3921
# Optional full override (otherwise http://HOST:PORT)
# DEGIROID_API_ORIGIN=http://127.0.0.1:3921

# Exposed to the browser extension (must match the API origin above)
PUBLIC_DEGIROID_API_ORIGIN=http://127.0.0.1:3921

# --- Degiroid MCP (HTTP) ---
DEGIROID_MCP_HOST=127.0.0.1
DEGIROID_MCP_PORT=3922
DEGIROID_MCP_PATH=/mcp
# Optional full override (otherwise http://HOST:PORT/PATH)
# DEGIROID_MCP_URL=http://127.0.0.1:3922/mcp

# --- Job bridge / recommendations ---
DEGIROID_JOB_TIMEOUT_MS=180000
DEGIROID_JOB_POLL_WAIT_MS=60000
DEGIROID_RECS_CACHE_TTL_MS=120000
# Max order notional (EUR) per suggested buy; quantity = floor(max / entry price),
DEGIROID_MAX_BUY_ORDER_AMOUNT=3500

# --- Mastra (optional — without a key, structured heuristics are used) ---
MASTRA_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
